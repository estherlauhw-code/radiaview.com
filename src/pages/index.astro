---
// RadiaView 官方網站 - B2B LED 永續解決方案終極優化版首頁
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RadiaView Display Technology | Sustainable B2B LED Solutions</title>
    <!-- 引入全相容現代樣式庫與字體 -->
    <link rel="stylesheet" href="https://cloudflare.com" />
    <link href="https://googleapis.com" rel="stylesheet" />
    <link rel="stylesheet" href="https://cloudflare.com" />
    
    <!-- 專屬高階科技網頁排版設計 -->
    <style is:global>
        :root {
            --bg-color: #020617;
            --text-color: #cbd5e1;
            --accent-emerald: #10b981;
            --accent-cyan: #06b6d4;
            --card-bg: #0f172a;
            --card-border: #1e293b;
        }
        body {
            background-color: var(--bg-color) !important;
            color: var(--text-color) !important;
            font-family: 'Inter', sans-serif !important;
            margin: 0;
            padding: 0;
            line-height: 1.6;
        }
        .max-width-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }
        /* 導覽列 */
        nav {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 100;
            background: rgba(2, 6, 23, 0.7);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(16, 185, 129, 0.15);
        }
        .nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 80px;
        }
        .logo {
            font-size: 24px;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -1px;
            display: flex;
            align-items: center;
        }
        .logo-accent { color: var(--accent-emerald); }
        .nav-links {
            display: flex;
            align-items: center;
            gap: 30px;
        }
        .nav-links a {
            color: #cbd5e1;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            transition: color 0.3s;
        }
        .nav-links a:hover { color: var(--accent-emerald); }
        .btn-nav {
            background-color: var(--accent-emerald) !important;
            border: none !important;
            color: #020617 !important;
            font-weight: 700 !important;
            padding: 10px 24px !important;
            border-radius: 9999px !important;
            text-transform: none !important;
            height: auto !important;
            line-height: inherit !important;
            box-shadow: 0 0 15px rgba(16, 185, 129, 0.3);
        }
        /* 主視覺區 */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            position: relative;
            padding-top: 80px;
        }
        .hero-badge {
            display: inline-block;
            padding: 6px 16px;
            border-radius: 9999px;
            border: 1px solid rgba(16, 185, 129, 0.3);
            background: rgba(16, 185, 129, 0.1);
            color: #34d399;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 24px;
        }
        .hero h1 {
            font-size: 64px;
            font-weight: 800;
            color: #ffffff;
            line-height: 1.1;
            margin-bottom: 24px;
            letter-spacing: -2px;
        }
        .gradient-text {
            background: linear-gradient(to right, #34d399, #22d3ee);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .hero p {
            font-size: 18px;
            color: #94a3b8;
            max-width: 750px;
            margin: 0 auto 40px auto;
        }
        .hero-btns {
            display: flex;
            justify-content: center;
            gap: 20px;
        }
        .btn-primary {
            background-color: var(--accent-emerald) !important;
            border: none !important;
            color: #020617 !important;
            font-weight: 700 !important;
            padding: 15px 32px !important;
            border-radius: 8px !important;
            height: auto !important;
            line-height: inherit !important;
        }
        .btn-secondary {
            background-color: transparent !important;
            border: 1px solid rgba(6, 182, 212, 0.5) !important;
            color: #22d3ee !important;
            font-weight: 700 !important;
            padding: 15px 32px !important;
            border-radius: 8px !important;
            height: auto !important;
            line-height: inherit !important;
        }
        /* 產品區塊 */
        .products-section {
            padding: 100px 0;
            background: rgba(15, 23, 42, 0.3);
            border-top: 1px solid #0f172a;
        }
        .section-header {
            text-align: center;
            margin-bottom: 60px;
        }
        .section-header h2 {
            font-size: 40px;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 10px;
        }
        .section-header p { color: #94a3b8; }
        .bento-grid {
            display: grid;
            grid-template-cols: repeat(auto-fit, minmax(450px, 1fr));
            gap: 40px;
        }
        .bento-card {
            background-color: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            padding: 40px;
            position: relative;
            transition: all 0.3s;
        }
        .bento-card:hover {
            border-color: rgba(16, 185, 129, 0.4);
            box-shadow: 0 0 35px -10px rgba(16, 185, 129, 0.3);
        }
        .card-icon-bg {
            position: absolute;
            top: 20px;
            right: 20px;
            font-size: 80px;
            opacity: 0.05;
            color: var(--accent-emerald);
        }
        .card-badge {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 24px;
            font-size: 20px;
        }
        .bg-emerald {
            background: rgba(16, 185, 129, 0.2);
            border: 1px solid rgba(16, 185, 129, 0.3);
            color: var(--accent-emerald);
        }
        .bg-cyan {
            background: rgba(6, 182, 212, 0.2);
            border: 1px solid rgba(6, 182, 212, 0.3);
            color: var(--accent-cyan);
        }
        .bento-card h3 {
            font-size: 28px;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 15px;
        }
        .bento-card p {
            color: #94a3b8;
            margin-bottom: 30px;
            font-size: 16px;
        }
        .feature-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        .feature-list li {
            display: flex;
            align-items: center;
            margin-bottom: 12px;
            font-size: 15px;
            color: #cbd5e1;
        }
        .feature-list i {
            margin-right: 12px;
            font-size: 14px;
        }
        .text-emerald { color: var(--accent-emerald); }
        .text-cyan { color: var(--accent-cyan); }
    </style>
</head>
<body>

    <!-- 1. Navigation Bar -->
    <nav>
        <div class="max-width-container nav-container">
            <div class="logo">
                <i class="fa-solid fa-leaf logo-accent" style="margin-right: 10px;"></i>
                Radia<span class="logo-accent">View</span>
            </div>
            <div class="nav-links">
                <a href="#products">Products</a>
                <a href="#sustainability">Sustainability</a>
                <a href="#solutions">Solutions</a>
                <a href="#contact" class="btn-nav">Request ESG Report</a>
            </div>
        </div>
    </nav>

    <!-- 2. Hero Section -->
    <section class="hero max-width-container">
        <div>
            <div class="hero-badge">Next-Generation Micro-MiP</div>
            <h1>Redefining Displays with <br /><span class="gradient-text">Sustainable Brilliance.</span></h1>
            <p>Experience 35% energy savings, smart microgrid integration, and zero-carbon footprints. Our technology delivers uncompromising visual purity for B2B integrators, featuring a substrate-less and completely solderless architecture.</p>
            <div class="hero-btns">
                <a href="#products" class="btn-primary">Explore Micro-MiP <i class="fa-solid fa-arrow-right" style="margin-left: 8px;"></i></a>
                <a href="#contact" class="btn-secondary"><i class="fa-solid fa-bolt" style="margin-right: 8px;"></i> Smart Grid Integration</a>
            </div>
        </div>
    </section>

    <!-- 3. Bento Grid Feature Section -->
    <section id="products" class="products-section">
        <div class="max-width-container">
            <div class="section-header">
                <h2>A Purpose-Built Portfolio</h2>
                <p>Engineered for high-efficiency continuous operation.</p>
            </div>
            
            <div class="bento-grid">
                <!-- Card 1: Indoor -->
                <div class="bento-card">
                    <div class="card-icon-bg"><i class="fa-solid fa-microchip"></i></div>
                    <div class="card-badge bg-emerald"><i class="fa-solid fa-border-all"></i></div>
